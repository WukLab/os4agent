#!/usr/bin/with-contenv bash

export XCURSOR_THEME=breeze

if [ ! -f '/dev/shm/audio.lock' ]; then
  until [ -f /defaults/pid ]; do
    sleep .5
  done
  for _ in $(seq 1 10); do
    if s6-setuidgid abc with-contenv pactl info > /dev/null 2>&1; then
      break
    fi
    sleep .5
  done
  if s6-setuidgid abc with-contenv pactl \
    load-module module-null-sink \
    sink_name="output" \
    sink_properties=device.description="output" && \
    s6-setuidgid abc with-contenv pactl \
      load-module module-null-sink \
      sink_name="input" \
      sink_properties=device.description="input"; then
    touch /dev/shm/audio.lock
  else
    echo "[svc-selkies] pulseaudio not ready or sink creation failed, starting without audio sinks"
  fi
fi

if [ ! -z ${DEV_MODE+x} ]; then
  apt-get update
  apt-get install -y \
    nodejs
  npm install -g nodemon
  rm -Rf $HOME/.npm
  if [[ "${DEV_MODE}" == "pixelflux" ]]; then
    apt-get install -y \
      cargo \
      clang \
      cmake \
      curl \
      g++ \
      gcc \
      git \
      libclang-dev \
      libdav1d-dev \
      libde265-dev \
      libdrm-dev \
      libgbm-dev \
      libinput-dev \
      libpixman-1-dev \
      libsvtav1enc-dev \
      libudev-dev \
      libvpx-dev \
      libwayland-dev \
      libx264-dev \
      libx265-dev \
      libxkbcommon-dev \
      make \
      nasm \
      python3-dev \
      python3-pip \
      python3-setuptools \
      python3-setuptools-rust \
      python3-wheel \
      rustc
    chown -R abc:abc /lsiopy
    cd /config/src
    s6-setuidgid abc \
      nodemon -V \
      --watch . \
      --ext py,cpp,h,c,rs,toml \
      --ignore "pixelflux_wayland/target/" \
      --ignore "build/" \
      --ignore "*.egg-info/" \
      --ignore "__pycache__/" \
      --exec "pip uninstall -y pixelflux || true && pip install . --break-system-packages && (killall labwc || true) && (killall selkies-desktop || true) && cd /tmp && python3 -m selkies --addr='localhost' --debug='true'"
  else
    if [[ "${DEV_MODE}" == "core" ]]; then
      cd $HOME/src/addons/selkies-web-core
      s6-setuidgid abc npm install
      s6-setuidgid abc npm run serve &
    else
      cd $HOME/src/addons/selkies-web-core
      s6-setuidgid abc npm install
      s6-setuidgid abc npm run build
      s6-setuidgid abc cp dist/selkies-core.js ../${DEV_MODE}/src/
      s6-setuidgid abc nodemon \
        --watch . \
        --ext js,html \
        --ignore dist/ \
        --ignore node_modules/ \
        --exec "npm run build && cp dist/selkies-core.js ../${DEV_MODE}/src/" &
      s6-setuidgid abc cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/
      s6-setuidgid abc nodemon \
        --watch ../universal-touch-gamepad/universalTouchGamepad.js \
        --exec "cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/" &
      s6-setuidgid abc cp -a nginx ../${DEV_MODE}/
      cd $HOME/src/addons/${DEV_MODE}
      s6-setuidgid abc npm install
      s6-setuidgid abc npm run serve &
    fi
    cd $HOME/src/src
    s6-setuidgid abc \
      nodemon -V --ext py --watch . --exec \
        "killall labwc || true; killall selkies-desktop || true; python3 -m selkies --addr='localhost' --debug='true'"
  fi
fi

exec s6-setuidgid abc \
  selkies \
    --addr="localhost"
