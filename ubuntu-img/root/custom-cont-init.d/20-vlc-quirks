#!/usr/bin/with-contenv bash

set -euo pipefail

VLC_DIR=/config/.config/vlc
VLCRC=${VLC_DIR}/vlcrc

if [ ! -f "${VLCRC}" ]; then
    mkdir -p "${VLC_DIR}"
    cat > "${VLCRC}" <<'EOF'
[qt]
qt-privacy-ask=0
qt-recentplay=0
qt-updates-notif=0
qt-error-dialogs=0

[core]
metadata-network-access=0
EOF
fi

chown -R abc:abc /config/.config
